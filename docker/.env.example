# docker/.env.example
# Development template. Run docker/dev-setup.sh to turn this into docker/.env
# with generated secrets. Deployment configuration lives in Jamyn/dispatch-docker.
#
# Every REPLACE_WITH_GENERATED_SECRET below is filled in by dev-setup.sh. That
# string must stay byte-identical to PLACEHOLDER_SECRET in dev-setup.sh; if the
# two drift, generation silently no-ops and ships this file's placeholder.

# Pins the compose project name so the postgres volume is predictably named
# docker_postgres-data, which dev-setup.sh inspects to decide whether the
# cluster is already initialized. "docker" is what compose infers today from
# this file's directory -- setting it explicitly removes the dependency on the
# directory name without renaming the existing volume or the
# docker-postgres-1 container that the project's runbooks reference by name.
COMPOSE_PROJECT_NAME=docker

# General
DISPATCH_UI_URL=http://localhost:8080
LOG_LEVEL=INFO
STATIC_DIR=""
DISPATCH_AUTHENTICATION_PROVIDER_SLUG=dispatch-auth-provider-basic

# To develop against an OpenID Connect provider (Okta, Google, Keycloak,
# Microsoft Entra ID) instead, set the slug above to dispatch-auth-provider-pkce
# and fill these in. The VITE_-prefixed one is read when the frontend bundle is
# built, not when the server starts. See
# docs/docs/administration/settings/authentication-entra-id.mdx for a worked
# Entra example. None of these is a secret.
# DISPATCH_AUTHENTICATION_PROVIDER_PKCE_JWKS=
# DISPATCH_AUTHENTICATION_PROVIDER_PKCE_ISSUER=
# DISPATCH_AUTHENTICATION_PROVIDER_PKCE_CLIENT_ID=
# DISPATCH_AUTHENTICATION_PROVIDER_USE_ID_TOKEN=true
# DISPATCH_JWT_AUDIENCE=
# DISPATCH_JWT_EMAIL_OVERRIDE=
# VITE_DISPATCH_AUTHENTICATION_PROVIDER_PKCE_OPEN_ID_CONNECT_URL=

# Postgres container. The image applies POSTGRES_PASSWORD only while it
# initializes the data directory, so dev-setup.sh will not regenerate it once
# the volume holds a cluster -- the server would keep the old password.
POSTGRES_USER=postgres
POSTGRES_DB=dispatch
POSTGRES_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# pgadmin. No volume is mounted for it, so this applies on every container
# creation and is safe to regenerate freely.
PGADMIN_DEFAULT_EMAIL=dispatch@example.com
PGADMIN_DEFAULT_PASSWORD=REPLACE_WITH_GENERATED_SECRET

# Application. DATABASE_CREDENTIALS is the same credential as above in
# user:password form; dev-setup.sh rewrites it whenever it writes the password.
DATABASE_HOSTNAME=localhost
DATABASE_NAME=dispatch
DATABASE_PORT=5432
DATABASE_CREDENTIALS=REPLACE_WITH_GENERATED_SECRET

# DISPATCH_ENCRYPTION_KEY encrypts plugin configuration at rest. Rotating it
# makes anything already stored undecryptable, so it is gated on the same
# empty-volume check as the database password.
DISPATCH_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_SECRET
DISPATCH_JWT_SECRET=REPLACE_WITH_GENERATED_SECRET
