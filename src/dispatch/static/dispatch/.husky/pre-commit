#!/usr/bin/env sh
# core.hooksPath points at this tracked directory, not husky's generated
# .husky/_: that one is gitignored, so a worktree -- which shares the main
# checkout's config -- finds no hook there and git skips pre-commit silently.
# Losing husky's _ wrapper also means HUSKY=0 no longer skips this hook; use
# `git commit --no-verify`.
cd "$(dirname -- "$0")/.." && npx lint-staged
