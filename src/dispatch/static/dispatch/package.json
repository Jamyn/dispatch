{
  "name": "dispatch",
  "version": "0.1.0",
  "private": true,
  "lint-staged": {
    "*.{js,jsx,vue,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "*.{html,css,less,ejs}": [
      "prettier --write"
    ]
  },
  "scripts": {
    "build": "vite build --out-dir dist",
    "lint": "eslint src --ext .js,.vue,.ts",
    "lint:fix": "eslint src --ext .js,.vue,.ts --fix",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --open --port 8080",
    "serve": "cross-env NODE_ENV=dev NODE_OPTIONS='--max-http-header-size=100000' vite",
    "test": "vitest --dom",
    "preinstall": "node preinstall.js",
    "prepare": "cd ../../../.. && husky src/dispatch/static/dispatch/.husky && [ \"$HUSKY\" = \"0\" ] || ! [ -e .git ] || git config core.hooksPath src/dispatch/static/dispatch/.husky"
  },
  "dependencies": {
    "@formkit/pro": "^0.130.0",
    "@formkit/themes": "^2.1.2",
    "@formkit/vue": "^1.3.0",
    "@json2csv/plainjs": "^7.0.8",
    "@json2csv/transforms": "^7.0.8",
    "@mdi/font": "^7.4.47",
    "@monaco-editor/loader": "^1.7.0",
    "@openid/appauth": "^1.3.1",
    "@sentry/vue": "^6.19.7",
    "@tanstack/vue-query": "^5.101.4",
    "@tiptap/extension-placeholder": "^2.1.13",
    "@tiptap/pm": "^2.1.12",
    "@tiptap/starter-kit": "^2.1.12",
    "@tiptap/vue-3": "^2.1.12",
    "@vue-flow/background": "^1.2.0",
    "@vue-flow/controls": "^1.1.0",
    "@vue-flow/core": "^1.48.2",
    "@vue-flow/minimap": "^1.5.4",
    "@vueuse/core": "^10.5.0",
    "@vueuse/integrations": "^10.6.1",
    "apexcharts": "^3.44.0",
    "axios": "^1.19.0",
    "d3-force": "^3.0.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "dompurify": "^3.4.14",
    "font-awesome": "^4.7.0",
    "json-to-ast": "^2.1.0",
    "jsonpath": "^1.3.0",
    "jwt-decode": "^3.1.2",
    "lodash": "^4.18.1",
    "mjml": "^5.4.0",
    "moment-timezone": "^0.6.3",
    "monaco-editor": "0.56.0",
    "register-service-worker": "^1.7.2",
    "roboto-fontface": "^0.10.0",
    "sass-embedded": "^1.102.0",
    "sortablejs": "^1.15.7",
    "swrv": "^1.2.0",
    "vue": "^3.5.41",
    "vue-router": "^4.2.5",
    "vue3-apexcharts": "~1.7.0",
    "vue3-markdown-it": "^1.0.10",
    "vuetify": "^3.4.3",
    "vuex": "^4.1.0",
    "vuex-map-fields": "^1.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/jsonpath": "^0.2.4",
    "@typescript-eslint/eslint-plugin": "^8.66.0",
    "@typescript-eslint/parser": "^8.66.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.11",
    "@vue/test-utils": "^2.4.11",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^8.10.0",
    "eslint-plugin-local-rules": "^2.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-vue": "^10.10.0",
    "eslint-plugin-vuetify": "^2.7.2",
    "happy-dom": "^20.11.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "unplugin-vue-components": "^0.22.12",
    "vite": "^8.2.1",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vitest": "^4.1.10",
    "vue-eslint-parser": "^10.3.0"
  },
  "overrides": {
    "underscore": "1.13.8",
    "ajv": "6.14.0",
    "monaco-editor": {
      "dompurify": "3.4.14"
    },
    "@eslint/eslintrc": {
      "minimatch": "3.1.4"
    },
    "@humanwhocodes/config-array": {
      "minimatch": "3.1.4"
    },
    "eslint": {
      "minimatch": "3.1.4"
    },
    "rimraf": {
      "minimatch": "3.1.4"
    },
    "unplugin-vue-components": {
      "minimatch": "5.1.8"
    },
    "editorconfig": {
      "minimatch": "9.0.7"
    }
  }
}
