{
  "compilerOptions": {
    "target": "ES2022",
    "module": "preserve",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "allowJs": true,
    "checkJs": false,
    "paths": {
      "@/*": ["./src/*"],
      "vuex": ["./node_modules/vuex/types/index.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.js", "src/**/*.vue", "components.d.ts"],
  "exclude": ["node_modules", "dist", "coverage"]
}
